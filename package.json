{
  "name": "readback-copilot",
  "productName": "Readback Copilot",
  "version": "3.0.0",
  "private": true,
  "description": "Copilota radio per VATSIM: ascolta l'ATC e mostra il readback corretto, allenamento, briefing e frasario.",
  "author": "IMTZSON",
  "license": "UNLICENSED",
  "main": "electron/main.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "electron .",
    "serve": "node electron/server.js",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "43.7.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "app.readbackcopilot.desktop",
    "productName": "Readback Copilot",
    "copyright": "IMTZSON",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "css/**",
      "js/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Readback Copilot",
      "artifactName": "ReadbackCopilot-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "ReadbackCopilot-Portable-${version}.${ext}"
    }
  }
}
