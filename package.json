{
  "name": "readback-copilot",
  "productName": "Readback Copilot",
  "version": "4.3.0",
  "private": true,
  "description": "Copilota radio per VATSIM: ascolta l'ATC e mostra il readback corretto, allenamento, briefing e frasario.",
  "author": "IMTZSON",
  "license": "UNLICENSED",
  "main": "electron/main.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "electron .",
    "serve": "node electron/server.js",
    "build:data": "node scripts/build-data.js",
    "dist": "electron-builder --win --x64 --publish never",
    "test:e2e": "node --test tests-e2e/*.e2e.js"
  },
  "devDependencies": {
    "electron": "43.7.3",
    "electron-builder": "26.15.3",
    "playwright": "1.56.1",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "build": {
    "appId": "app.readbackcopilot.desktop",
    "productName": "Readback Copilot",
    "copyright": "IMTZSON",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "css/**",
      "js/**",
      "data/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Readback Copilot",
      "artifactName": "ReadbackCopilot-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "ReadbackCopilot-Portable-${version}.${ext}"
    },
    "npmRebuild": false,
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/IMTZSON/Vat/releases/latest/download"
      }
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**",
      "node_modules/node-simconnect/**"
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "node-simconnect": "4.2.1",
    "uiohook-napi": "1.5.5"
  },
  "pro": {
    "endpoint": "",
    "checkout": ""
  }
}
